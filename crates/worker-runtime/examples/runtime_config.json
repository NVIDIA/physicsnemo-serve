{
  "stream_prefix": "physicsnemo:",
  "max_retries": 5,
  "shared_dlq_stream": "dlq",
  "streams": [
    "prefetch",
    "schedule",
    "release",
    "publish",
    "results"
  ],
  "roles": {
    "prefetch": {
      "inputs": [
        {
          "stream": "prefetch",
          "max_dequeue_items": 8,
          "poll_interval_ms": 100,
          "block_ms": 2000
        }
      ],
      "outputs": ["schedule"]
    },
    "scheduler": {
      "inputs": [
        {
          "stream": "schedule",
          "max_dequeue_items": 8,
          "poll_interval_ms": 100,
          "block_ms": 2000
        },
        {
          "stream": "release",
          "max_dequeue_items": 4,
          "poll_interval_ms": 500,
          "block_ms": 1000
        }
      ],
      "outputs": [],
      "config": {
        "gpu_registry_key": "gpu:registry",
        "batching_enabled": true,
        "max_batch_size": 4,
        "max_batch_wait_ms": 200
      }
    },
    "results": {
      "inputs": [
        {
          "stream": "results",
          "max_dequeue_items": 16,
          "poll_interval_ms": 100,
          "block_ms": 2000
        }
      ],
      "outputs": [],
      "config": {
        "result_ttl_seconds": 86400
      }
    },
    "publish": {
      "inputs": [
        {
          "stream": "publish",
          "max_dequeue_items": 8,
          "poll_interval_ms": 100,
          "block_ms": 2000
        }
      ],
      "outputs": [],
      "config": {
        "max_concurrent_files": 16,
        "multipart_threshold_bytes": 67108864,
        "multipart_part_size_bytes": 16777216,
        "multipart_max_concurrency": 4,
        "client_options": {
          "timeout_secs": 300,
          "connect_timeout_secs": 10,
          "pool_max_idle_per_host": 64
        },
        "retry": {
          "max_retries": 10,
          "timeout_secs": 300
        }
      }
    }
  },
  "python_runtime_envs": {
    "python.test": {
      "python_executable": "python3",
      "env": {},
      "launch": {
        "enabled": true,
        "device_kind": "cpu",
        "replicas": 1,
        "tags": ["demo", "cpu"]
      }
    }
  },
  "output_publication": {
    "enabled": false
  }
}
