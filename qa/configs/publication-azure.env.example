# Generic Azure Blob publication QA environment template.
#
# Export the required storage settings and one supported Azure credential before
# sourcing this file. The template preserves values already present in the shell.
#
# Example:
#   export QA_PUBLICATION_AZURE_ENDPOINT="https://replace-with-account.blob.core.windows.net"
#   export QA_PUBLICATION_AZURE_CONTAINER="replace-with-container"
#   export AZURE_STORAGE_ACCOUNT_NAME="replace-with-account"
#   export AZURE_STORAGE_ACCOUNT_KEY="<storage-account-key>"
#   set -a
#   source qa/configs/publication-azure.env.example
#   set +a
#   python -u qa/scripts/run_qa.py --service rust --image-tag <tag> --suite publication --lustre-dir publication
#
# Never add real storage keys or SAS tokens to this file.

QA_PUBLICATION_STORAGE_TYPE=azure
QA_PUBLICATION_AZURE_ENDPOINT="${QA_PUBLICATION_AZURE_ENDPOINT:-}"
QA_PUBLICATION_AZURE_CONTAINER="${QA_PUBLICATION_AZURE_CONTAINER:-}"
QA_PUBLICATION_PREFIX="${QA_PUBLICATION_PREFIX:-outputs}"
AZURE_STORAGE_ACCOUNT_NAME="${AZURE_STORAGE_ACCOUNT_NAME:-}"

# Credentials are intentionally supplied only through the operator environment.
# Supported options include AZURE_STORAGE_ACCOUNT_KEY,
# AZURE_STORAGE_ACCESS_KEY, and AZURE_STORAGE_SAS_TOKEN.

# Optional publish-worker upload tuning:
# QA_PUBLICATION_UPLOAD_MAX_CONCURRENT_FILES=96
# QA_PUBLICATION_UPLOAD_TIMEOUT_SECS=300
# QA_PUBLICATION_UPLOAD_CONNECT_TIMEOUT_SECS=10
# QA_PUBLICATION_UPLOAD_POOL_MAX_IDLE_PER_HOST=192
# QA_PUBLICATION_UPLOAD_RETRY_MAX_RETRIES=10
# QA_PUBLICATION_UPLOAD_RETRY_TIMEOUT_SECS=300
