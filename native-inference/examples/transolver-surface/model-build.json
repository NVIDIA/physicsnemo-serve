    "tensorrt_exact_layer_norm_plugin": "assets/tensorrt/libpnmir_tensorrt_exact_layer_norm_plugin.so",
    "tensorrt_exact_softmax_plugin": "assets/tensorrt/libpnmir_tensorrt_exact_softmax_plugin.so",
    "tensorrt_exact_attention_plugin": "assets/tensorrt/libpnmir_tensorrt_exact_attention_plugin.so",
