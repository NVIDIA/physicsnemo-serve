# Inference Server Example Environment

PORT=8080

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

DEFAULT_OUTPUT_DIR=/outputs
ARTIFACT_DIR=/artifacts

# Plugin boot discovery
PLUGIN_DIR=./plugins
# Optional: expose only the plugin whose manifest metadata.id matches this value.
# Leave empty or unset to enable every discovered plugin.
PHYSICSNEMO_SERVE_ENABLED_PLUGIN_ID=

# Plugin manifests and schema contracts are loaded once at startup.
# Restart the container to pick up workflow changes.
ARTIFACT_CLEANUP_INTERVAL_SECS=30

INFERENCE_STREAM=inference
PREFETCH_STREAM=prefetch
USE_PREFETCH=true

RUST_LOG=info
