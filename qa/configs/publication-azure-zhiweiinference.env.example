# Azure Blob publication QA config for the zhiweiinference storage account.
#
# Usage:
#   set -a
#   source qa/configs/publication-azure-zhiweiinference.env.example
#   set +a
#   export AZURE_STORAGE_ACCOUNT_KEY="<storage-account-key>"
#   python -u qa/scripts/run_qa.py --service rust --image-tag <tag> --suite publication --lustre-dir publication
#
# Do not commit real storage keys or SAS tokens.

QA_PUBLICATION_STORAGE_TYPE=azure
QA_PUBLICATION_AZURE_ENDPOINT=https://zhiweiinference.blob.core.windows.net

# Required: replace with the Azure container that should receive published outputs.
QA_PUBLICATION_AZURE_CONTAINER="replace-with-container-name"

QA_PUBLICATION_PREFIX=physicsnemo-serve-output

# Azure SDK / object_store credential environment.
AZURE_STORAGE_ACCOUNT_NAME=zhiweiinference

# Either set AZURE_STORAGE_ACCOUNT_KEY (preferred for object_store's Azure
# builder) or AZURE_STORAGE_ACCESS_KEY (used by the Python QA verifier).
# AZURE_STORAGE_ACCOUNT_KEY=<storage-account-key>
# AZURE_STORAGE_ACCESS_KEY=<storage-account-key>

# Optional publish-worker upload tuning.
QA_PUBLICATION_UPLOAD_MAX_CONCURRENT_FILES=96
QA_PUBLICATION_UPLOAD_TIMEOUT_SECS=300
QA_PUBLICATION_UPLOAD_CONNECT_TIMEOUT_SECS=10
QA_PUBLICATION_UPLOAD_POOL_MAX_IDLE_PER_HOST=192
QA_PUBLICATION_UPLOAD_RETRY_MAX_RETRIES=10
QA_PUBLICATION_UPLOAD_RETRY_TIMEOUT_SECS=300
