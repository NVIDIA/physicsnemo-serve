#
# Multi-stage build using cargo-chef for optimal dependency caching
# - Stage 1 (chef): Install shared Rust build tooling
# - Stage 2 (planner): Generate dependency recipe from Cargo.toml/lock
# - Stage 3 (builder): Cook dependencies (cached), then build binaries
# - Stage 4 (runtime): Minimal image with binaries + Python wheel
#
# Build with: DOCKER_BUILDKIT=1 docker build -f Dockerfile.physicsnemo-serve.scicomp-rust-slim -t e2s-rust .

# =============================================================================
# Stage 1: Chef - Shared Rust build tooling
# =============================================================================
ARG PHYSICSNEMO_SERVE_RUNTIME_BASE_IMAGE=physicsnemo-serve-runtime-base:latest
ARG PHYSICSNEMO_SERVE_BUILD_BASE_IMAGE=nvcr.io/nvidia/base/ubuntu:jammy-20260217
ARG PHYSICSNEMO_SERVE_PLATFORM=linux/amd64
FROM --platform=${PHYSICSNEMO_SERVE_PLATFORM} ${PHYSICSNEMO_SERVE_BUILD_BASE_IMAGE} AS chef
WORKDIR /src

COPY .cargo/config.toml .cargo/config.toml

ARG DEBIAN_FRONTEND=noninteractive
ARG RUSTUP_VERSION=1.28.2
ARG RUST_TOOLCHAIN=1.94.1

ENV RUSTUP_HOME="/usr/local/rustup" \
    CARGO_HOME="/usr/local/cargo" \
    RUSTUP_X86_64_SHA256="20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c" \
    PATH="/usr/local/cargo/bin:${PATH}"

RUN apt-get update -o Acquire::Retries=3 \
 && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    pkg-config \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN rustup_target="x86_64-unknown-linux-gnu" \
 && rustup_url="https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${rustup_target}/rustup-init" \
 && curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
    --output /tmp/rustup-init "${rustup_url}" \
 && actual_sha256="$(sha256sum /tmp/rustup-init | awk '{ print $1 }')" \
 && test "${actual_sha256}" = "${RUSTUP_X86_64_SHA256}" \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
 && rm -f /tmp/rustup-init

# Install cargo-chef
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo install cargo-chef --locked

# =============================================================================
# Stage 2: Planner - Generate cargo-chef recipe
# =============================================================================
FROM chef AS planner

# Copy workspace manifests.
COPY Cargo.toml Cargo.lock ./
COPY crates/inference_server/Cargo.toml ./crates/inference_server/
COPY crates/physicsnemo-serve-cmd/Cargo.toml ./crates/physicsnemo-serve-cmd/
COPY crates/scicomp-rq/Cargo.toml ./crates/scicomp-rq/
COPY crates/worker-runtime/Cargo.toml ./crates/worker-runtime/
COPY crates/e2s_zarr_io/Cargo.toml ./crates/e2s_zarr_io/

# Create minimal source stubs for cargo-chef to analyze
RUN mkdir -p crates/inference_server/src && echo "fn main() {}" > crates/inference_server/src/main.rs \
 && mkdir -p crates/physicsnemo-serve-cmd/src \
 && echo "pub fn dummy() {}" > crates/physicsnemo-serve-cmd/src/lib.rs \
 && echo "fn main() {}" > crates/physicsnemo-serve-cmd/src/main.rs \
 && echo "fn main() {}" > crates/physicsnemo-serve-cmd/src/runtime_installer_main.rs \
 && mkdir -p crates/scicomp-rq/src && echo "pub fn dummy() {}" > crates/scicomp-rq/src/lib.rs \
 && mkdir -p crates/scicomp-rq/benches && echo "fn main() {}" > crates/scicomp-rq/benches/redis_utils_parser.rs \
 && mkdir -p crates/worker-runtime/src && echo "fn main() {}" > crates/worker-runtime/src/main.rs \
 && mkdir -p crates/e2s_zarr_io/src && echo "pub fn dummy() {}" > crates/e2s_zarr_io/src/lib.rs \
 && mkdir -p crates/e2s_zarr_io/benches && echo "fn main() {}" > crates/e2s_zarr_io/benches/buffer_pool_latency.rs \
 && echo "fn main() {}" > crates/e2s_zarr_io/benches/write_copy_barrier_latency.rs \
 && echo "fn main() {}" > crates/e2s_zarr_io/benches/add_array_latency.rs

# Generate recipe.json (dependency graph for caching)
RUN cargo chef prepare --recipe-path recipe.json

# =============================================================================
# Stage 3: Builder - Cook dependencies, then build binaries
# =============================================================================
FROM chef AS builder

# Optimize Rust compilation
ENV CARGO_BUILD_JOBS=16 \
    CARGO_INCREMENTAL=0 \
    RUSTFLAGS="-C target-cpu=x86-64-v3"

# Install build dependencies: Python headers for PyO3, CMake for aws-lc-sys,
# and OpenSSL headers for inference_server's native-tls dependency.
RUN apt-get clean \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
 && find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -print0 | xargs -0 sed -i \
    -e 's|http://deb.debian.org|https://deb.debian.org|g' \
    -e 's|http://security.debian.org|https://security.debian.org|g' \
    -e 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g' \
    -e 's|http://security.ubuntu.com|https://security.ubuntu.com|g' \
 && apt-get update -o Acquire::Retries=3 \
 && apt-get install -y --no-install-recommends \
    python3-dev cmake libssl-dev curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
 && curl -L https://github.com/mozilla/sccache/releases/download/v0.8.2/sccache-v0.8.2-x86_64-unknown-linux-musl.tar.gz | tar xz -C /tmp \
 && mv /tmp/sccache-v0.8.2-x86_64-unknown-linux-musl/sccache /usr/local/bin/ \
 && curl -L https://github.com/PyO3/maturin/releases/download/v1.8.3/maturin-x86_64-unknown-linux-musl.tar.gz | tar xz -C /usr/local/bin/

# Set sccache as the Rust compiler wrapper.
# Pass --build-arg SCCACHE_DISABLE=1 to bypass sccache wrapper behavior.
ARG SCCACHE_DISABLE=0
ENV RUSTC_WRAPPER=sccache \
    SCCACHE_DIR=/tmp/sccache \
    SCCACHE_DISABLE=${SCCACHE_DISABLE}

# Copy recipe from planner stage
COPY --from=planner /src/recipe.json recipe.json

# Copy workspace manifests (needed for cargo chef cook).
COPY Cargo.toml Cargo.lock ./
COPY crates/inference_server/Cargo.toml ./crates/inference_server/
COPY crates/physicsnemo-serve-cmd/Cargo.toml ./crates/physicsnemo-serve-cmd/
COPY crates/scicomp-rq/Cargo.toml ./crates/scicomp-rq/
COPY crates/worker-runtime/Cargo.toml ./crates/worker-runtime/
COPY crates/e2s_zarr_io/Cargo.toml ./crates/e2s_zarr_io/

# Create minimal source stubs required for manifest parsing during cargo-chef cook.
RUN mkdir -p crates/inference_server/src && echo "fn main() {}" > crates/inference_server/src/main.rs \
 && mkdir -p crates/physicsnemo-serve-cmd/src \
 && echo "pub fn dummy() {}" > crates/physicsnemo-serve-cmd/src/lib.rs \
 && echo "fn main() {}" > crates/physicsnemo-serve-cmd/src/main.rs \
 && echo "fn main() {}" > crates/physicsnemo-serve-cmd/src/runtime_installer_main.rs \
 && mkdir -p crates/scicomp-rq/src && echo "pub fn dummy() {}" > crates/scicomp-rq/src/lib.rs \
 && mkdir -p crates/scicomp-rq/benches && echo "fn main() {}" > crates/scicomp-rq/benches/redis_utils_parser.rs \
 && mkdir -p crates/worker-runtime/src && echo "fn main() {}" > crates/worker-runtime/src/main.rs \
 && mkdir -p crates/e2s_zarr_io/src && echo "pub fn dummy() {}" > crates/e2s_zarr_io/src/lib.rs \
 && mkdir -p crates/e2s_zarr_io/benches && echo "fn main() {}" > crates/e2s_zarr_io/benches/buffer_pool_latency.rs \
 && echo "fn main() {}" > crates/e2s_zarr_io/benches/write_copy_barrier_latency.rs \
 && echo "fn main() {}" > crates/e2s_zarr_io/benches/add_array_latency.rs

# Cook dependencies for the Rust binaries this image actually ships.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/tmp/sccache \
    if [ "$SCCACHE_DISABLE" = "1" ]; then unset RUSTC_WRAPPER; fi; \
    cargo chef cook --release --locked --recipe-path recipe.json \
        --package inference_server \
        --package worker-runtime \
        --package physicsnemo-serve-cmd

# Cook the Python-extension dependency graph separately so maturin rebuilds are
# mostly limited to scicomp-rq when only local source changes.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/tmp/sccache \
    if [ "$SCCACHE_DISABLE" = "1" ]; then unset RUSTC_WRAPPER; fi; \
    cargo chef cook --release --locked --recipe-path recipe.json \
        --package scicomp-rq \
        --features python-extension

# Cook e2s_zarr_io's extension dependency graph separately so the upcoming
# runtime wheel build can reuse cached Rust dependencies.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/tmp/sccache \
    if [ "$SCCACHE_DISABLE" = "1" ]; then unset RUSTC_WRAPPER; fi; \
    cargo chef cook --release --locked --recipe-path recipe.json \
        --package e2s_zarr_io \
        --features python-extension-module

# Restore the real workspace manifest and lockfile after cargo-chef's synthetic
# skeleton so the actual build can run with --locked.
COPY Cargo.toml Cargo.lock ./
COPY crates/inference_server/Cargo.toml ./crates/inference_server/
COPY crates/physicsnemo-serve-cmd/Cargo.toml ./crates/physicsnemo-serve-cmd/
COPY crates/scicomp-rq/Cargo.toml ./crates/scicomp-rq/
COPY crates/worker-runtime/Cargo.toml ./crates/worker-runtime/
COPY crates/e2s_zarr_io/Cargo.toml ./crates/e2s_zarr_io/

# Build the Python wheel needed by the shipped execute worker before copying
# the binary-only crates, so worker-runtime changes do not invalidate this layer.
COPY crates/scicomp-rq ./crates/scicomp-rq
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/tmp/sccache \
    cd crates/scicomp-rq && env -u RUSTC_WRAPPER maturin build --release --locked --features python-extension

# Build the Rust-backed Zarr Python extension that will be used by upcoming
# Earth2Studio output paths.
COPY crates/e2s_zarr_io ./crates/e2s_zarr_io
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/tmp/sccache \
    cd crates/e2s_zarr_io && env -u RUSTC_WRAPPER maturin build --release --locked --features python-extension-module

# Copy binary source code after the wheel build to keep rebuilds scoped.
COPY crates/inference_server ./crates/inference_server
COPY crates/worker-runtime ./crates/worker-runtime
COPY crates/e2s_zarr_io ./crates/e2s_zarr_io

# Build binaries (only compiles your code, deps already built)
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/tmp/sccache \
    if [ "$SCCACHE_DISABLE" = "1" ]; then unset RUSTC_WRAPPER; fi; \
    cargo build --release --locked \
        -p inference_server \
        -p worker-runtime && \
    if [ "$SCCACHE_DISABLE" != "1" ]; then sccache --show-stats; fi

# =============================================================================
# Stage 4: Runtime - Org-scoped PyTorch mirror + CUDA
# =============================================================================
FROM --platform=${PHYSICSNEMO_SERVE_PLATFORM} ${PHYSICSNEMO_SERVE_RUNTIME_BASE_IMAGE} AS runtime
WORKDIR /app

ARG E2G_HASH=11dcf1b0787a7eb6a8497a3a5a5e1fdcc31232d3
ARG PHYSICSNEMO_CFD_COMMIT=921f14dc2ac14c04aabffaba3290deb792379dd8
ARG PHYSICSNEMO_CFD_VERSION=0.0.2
ARG PHYSICSNEMO_VERSION=2.1.1
ARG PHYSICSNEMO_CFD_TORCH_VERSION=2.10.0+cu128
ARG PHYSICSNEMO_CFD_TORCHVISION_VERSION=0.25.0+cu128
ARG PHYSICSNEMO_CFD_TORCH_SCATTER_VERSION=2.1.2+pt210cu128
ARG PHYSICSNEMO_NUMPY_VERSION=2.2.6
ARG PHYSICSNEMO_SCIPY_VERSION=1.18.0

ENV PHYSICSNEMO_CFD_VENV=/opt/physicsnemo-cfd-venv \
    PHYSICSNEMO_CFD_PYTHON_EXECUTABLE=/opt/physicsnemo-cfd-venv/bin/python

# The runtime base image owns the Python venv contract.
RUN test -x "$PHYSICSNEMO_SERVE_PYTHON_EXECUTABLE"

# Install third-party runtime dependencies before copying the repo-local wheel
# so Rust/Python binding changes do not invalidate this heavy layer.
RUN "$PHYSICSNEMO_SERVE_PYTHON_EXECUTABLE" -m pip install --no-cache-dir --no-build-isolation \
    "earth2grid @ git+https://github.com/NVlabs/earth2grid@${E2G_HASH}" && \
    "$PHYSICSNEMO_SERVE_PYTHON_EXECUTABLE" -m pip install --no-cache-dir \
    natten==0.21.5+torch2100cu130 -f https://whl.natten.org && \
    "$PHYSICSNEMO_SERVE_PYTHON_EXECUTABLE" -m pip install --no-cache-dir \
    redis 'pydantic>=2.0.0' boto3 s3fs python-dotenv aiofiles httpx \
    'warp-lang<1.12.0' \
    "earth2studio[dlwp,fcn,fcn3,stormcast,stormscope,perturbation,data]==0.13.0" \
    "git+https://github.com/NVIDIA/makani.git@b38fcb2799d7dbc146fa60459f3f9823394a8bf1" \
    'warp-lang<1.12.0' \
    cartopy cfgrib && \
    "$PHYSICSNEMO_SERVE_PYTHON_EXECUTABLE" -m pip install --no-cache-dir \
        "numpy==${PHYSICSNEMO_NUMPY_VERSION}" "scipy==${PHYSICSNEMO_SCIPY_VERSION}" && \
    "$PHYSICSNEMO_SERVE_PYTHON_EXECUTABLE" -c \
        "import numpy, scipy; assert numpy.__version__ == '${PHYSICSNEMO_NUMPY_VERSION}', numpy.__version__; assert scipy.__version__ == '${PHYSICSNEMO_SCIPY_VERSION}', scipy.__version__"

# Keep PhysicsNeMo-CFD separate from the Earth2Studio environment. The venv
# uses the base image's CUDA system libraries, while its Python packages and
# newer Warp dependency remain isolated in this environment.
RUN test "$(python3.12 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')" = "3.12" \
    && python3.12 -m venv "$PHYSICSNEMO_CFD_VENV" \
    && env -u PIP_CONSTRAINT "$PHYSICSNEMO_CFD_PYTHON_EXECUTABLE" -m pip install \
        --no-cache-dir --upgrade pip setuptools wheel

# PhysicsNeMo 2.1.1 requires the final PyTorch 2.10 release. Install the CUDA
# 12.8 wheel into the CFD venv to match the binary-mode runtime for numerical
# parity. The E2S venv above uses cu130; CFD uses cu128 intentionally.
# Use PhysicsNeMo's cu12 extra as the compatibility boundary for RAPIDS and
# CuPy, then layer the CFD GPU/HF extras on top.
RUN env -u PIP_CONSTRAINT "$PHYSICSNEMO_CFD_PYTHON_EXECUTABLE" -m pip install \
        --no-cache-dir --index-url https://download.pytorch.org/whl/cu128 \
        "torch==${PHYSICSNEMO_CFD_TORCH_VERSION}" \
        "torchvision==${PHYSICSNEMO_CFD_TORCHVISION_VERSION}" \
    && printf 'torch==%s\ntorchvision==%s\nnumpy==%s\nscipy==%s\n' \
        "${PHYSICSNEMO_CFD_TORCH_VERSION}" \
        "${PHYSICSNEMO_CFD_TORCHVISION_VERSION}" \
        "${PHYSICSNEMO_NUMPY_VERSION}" \
        "${PHYSICSNEMO_SCIPY_VERSION}" \
        > /tmp/physicsnemo-cfd-constraints.txt \
    && env -u PIP_CONSTRAINT "$PHYSICSNEMO_CFD_PYTHON_EXECUTABLE" -m pip install --no-cache-dir \
        "numpy==${PHYSICSNEMO_NUMPY_VERSION}" \
        "scipy==${PHYSICSNEMO_SCIPY_VERSION}" \
        redis 'pydantic>=2.0.0' 'hiredis>=2.0.0' python-dotenv aiofiles \
        'jsonschema>=4.26.0' \
    && env -u PIP_CONSTRAINT "$PHYSICSNEMO_CFD_PYTHON_EXECUTABLE" -m pip install --no-cache-dir \
        --constraint /tmp/physicsnemo-cfd-constraints.txt \
        --extra-index-url https://pypi.nvidia.com \
        "nvidia-physicsnemo[cu12]==${PHYSICSNEMO_VERSION}" \
        "nvidia-physicsnemo-cfd[evaluation-hf] @ git+https://github.com/NVIDIA/physicsnemo-cfd.git@${PHYSICSNEMO_CFD_COMMIT}" \
    && env -u PIP_CONSTRAINT "$PHYSICSNEMO_CFD_PYTHON_EXECUTABLE" -m pip install --no-cache-dir \
        --no-index \
        --find-links "https://data.pyg.org/whl/torch-2.10.0+cu128.html" \
        "torch-scatter==${PHYSICSNEMO_CFD_TORCH_SCATTER_VERSION}" \
    && env -u PIP_CONSTRAINT "$PHYSICSNEMO_CFD_PYTHON_EXECUTABLE" -m pip install --no-cache-dir \
        'numpy==2.2.6' 'scipy==1.18.0' 'torch-geometric==2.8.0.post1' \
    && "$PHYSICSNEMO_CFD_PYTHON_EXECUTABLE" -m pip check

# Fail the image build if the requested source revision, versions, Python ABI,
# or either optional dependency family was not installed into the CFD venv.
RUN "$PHYSICSNEMO_CFD_PYTHON_EXECUTABLE" - \
        "$PHYSICSNEMO_VERSION" \
        "$PHYSICSNEMO_CFD_VERSION" \
        "$PHYSICSNEMO_CFD_COMMIT" \
        "$PHYSICSNEMO_CFD_TORCH_VERSION" \
        "$PHYSICSNEMO_CFD_TORCHVISION_VERSION" \
        "$PHYSICSNEMO_CFD_TORCH_SCATTER_VERSION" \
        "$PHYSICSNEMO_NUMPY_VERSION" \
        "$PHYSICSNEMO_SCIPY_VERSION" <<'PY'
import importlib.metadata
import importlib.util
import json
import sys

import huggingface_hub
import numpy
import physicsnemo
import physicsnemo.cfd
import scipy
import torch
import torch_geometric
import torch_scatter
from packaging.version import Version

(
    expected_physicsnemo,
    expected_cfd,
    expected_commit,
    expected_torch,
    expected_torchvision,
    expected_torch_scatter,
    expected_numpy,
    expected_scipy,
) = sys.argv[1:]
assert sys.version_info[:2] == (3, 12), sys.version
assert physicsnemo.__version__ == expected_physicsnemo
assert physicsnemo.cfd.__version__ == expected_cfd
assert torch.__version__ == expected_torch
assert importlib.metadata.version("torchvision") == expected_torchvision
assert importlib.metadata.version("torch-scatter") == expected_torch_scatter
assert numpy.__version__ == expected_numpy
assert scipy.__version__ == expected_scipy
assert torch.version.cuda == "12.8"

distribution = importlib.metadata.distribution("nvidia-physicsnemo-cfd")
direct_url_text = distribution.read_text("direct_url.json")
assert direct_url_text is not None
direct_url = json.loads(direct_url_text)
assert direct_url["vcs_info"]["commit_id"] == expected_commit
for package, module in (
    ("huggingface-hub", "huggingface_hub"),
    ("torch-geometric", "torch_geometric"),
    ("torch-scatter", "torch_scatter"),
):
    assert importlib.metadata.version(package)
    assert importlib.util.find_spec(module) is not None
PY

# Copy local Python wheels after the third-party dependency layers so wheel
# changes do not force a rebuild of torch-harmonics and Earth2Studio extras.
COPY --from=builder /src/target/wheels/*.whl /tmp/wheels/
RUN "$PHYSICSNEMO_SERVE_PYTHON_EXECUTABLE" -m pip install --no-cache-dir /tmp/wheels/*.whl \
    && env -u PIP_CONSTRAINT "$PHYSICSNEMO_CFD_PYTHON_EXECUTABLE" -m pip install --no-cache-dir /tmp/wheels/*.whl \
    && "$PHYSICSNEMO_CFD_PYTHON_EXECUTABLE" -c "import scicomp_rq" \
    && mkdir -p /app/bin /app/config /app/plugins /outputs/.cache/physicsnemo-cfd/models

# Copy Rust binaries after the heavy Python dependency layers so binary-only
# rebuilds do not invalidate torch-harmonics or Earth2Studio installs.
COPY --from=builder /src/target/release/inference_server /app/bin/inference-server
COPY --from=builder /src/target/release/worker-runtime /app/bin/

# Copy profiles
COPY crates/worker-runtime/config/profiles.json /app/config/profiles.json

# Copy current production plugins and repo-local assets used by them.
COPY plugins/earth2-deterministic /app/plugins/earth2-deterministic
COPY plugins/earth2-deterministic-batch /app/plugins/earth2-deterministic-batch
COPY plugins/earth2-ensemble /app/plugins/earth2-ensemble
COPY plugins/earth2-ensemble-fanout /app/plugins/earth2-ensemble-fanout
COPY plugins/e2s-deterministic-earth2 /app/plugins/e2s-deterministic-earth2
COPY plugins/e2s-deterministic /app/plugins/e2s-deterministic
COPY plugins/e2s-deterministic-fcn /app/plugins/e2s-deterministic-fcn
COPY plugins/e2s-diagnostic /app/plugins/e2s-diagnostic
COPY plugins/e2s-ensemble /app/plugins/e2s-ensemble
COPY plugins/e2s-example-user /app/plugins/e2s-example-user
COPY plugins/e2s-foundry-fcn3 /app/plugins/e2s-foundry-fcn3
COPY plugins/e2s-foundry-fcn3-stormscope-goes /app/plugins/e2s-foundry-fcn3-stormscope-goes
COPY plugins/e2s-stormcast-fcn3 /app/plugins/e2s-stormcast-fcn3
COPY plugins/physicsnemo-cfd-surface-benchmark /app/plugins/physicsnemo-cfd-surface-benchmark

# Model checkpoints and other cached runtime artifacts.
# The directory ships as an empty stub in git.
COPY checkpoints /app/checkpoints

# Copy e2s_tools Python package for python_bridge.py (workflow inspection)
COPY python/e2s_tools /app/python/e2s_tools
# Copy Earth2Workflow base class used by e2s-* plugins
COPY python/e2s_workflow.py /app/python/e2s_workflow.py
# Copy import-light execution primitives shared by PhysicsNeMo-CFD plugins.
COPY python/physicsnemo_cfd_runtime /app/python/physicsnemo_cfd_runtime
# Copy the serve-owned per-item batch execution coordinator.
COPY python/batch_runtime.py /app/python/batch_runtime.py

# Copy entrypoint scripts (supervisor-based process management)
COPY scripts /app/scripts
# Keep an explicit copy of runtime role config for clarity.
COPY scripts/worker_runtime_config.json /app/scripts/worker_runtime_config.json

# Keep legacy start.sh for backward compatibility (simple mode without supervisor)
RUN <<'EOF'
set -e
chmod +x /app/scripts/*.sh
rm -rf /tmp/*
cat > /app/bin/start.sh <<'SCRIPT'
#!/bin/bash
set -e
echo "Starting Redis server..."
redis-server --daemonize yes --bind 127.0.0.1
# Wait for Redis to be ready
until redis-cli ping 2>/dev/null | grep -q PONG; do
    sleep 0.1
done
echo "Redis is ready"
if [ -x /app/bin/worker-runtime ] && [ -f "${WORKER_RUNTIME_CONFIG:-/app/scripts/worker_runtime_config.json}" ]; then
    export WORKER_ROLE=scheduler
    export WORKER_PIPELINE_CONFIG="${WORKER_RUNTIME_CONFIG:-/app/scripts/worker_runtime_config.json}"
    exec /app/bin/worker-runtime --role scheduler --config-path "$WORKER_PIPELINE_CONFIG" "$@"
fi
echo "ERROR: no scheduler binary available (worker-runtime)" >&2
